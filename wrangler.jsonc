{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "solarbuild360",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
  // Enable once solarbuild360.pro is an active zone in this Cloudflare account:
  // "routes": [
  //   { "pattern": "solarbuild360.pro", "custom_domain": true },
  //   { "pattern": "www.solarbuild360.pro", "custom_domain": true }
  // ]
}
